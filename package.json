{
  "name": "Junius",
  "version": "1.0.0",
  "description": "Junius Local Agent",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test",
    "sandbox:probe": "tsx src/sandbox-probe.ts",
    "sandbox:api-probe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe-windows-sandbox-api.ps1",
    "sandbox:mxc-probe": "tsx src/mxc-sandbox-probe.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5",
    "@microsoft/mxc-sdk": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
